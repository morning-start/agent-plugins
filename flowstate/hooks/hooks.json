{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "shell": "bash",
            "description": "Inject using-fst entry skill into session context"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-start.ps1\"",
            "shell": "powershell",
            "description": "Inject using-fst entry skill into session context"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-compact.sh\"",
            "shell": "bash",
            "description": "Generate ready-for-promotion document list after context compaction (checkpoint boundary)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/post-compact.ps1\"",
            "shell": "powershell",
            "description": "Generate ready-for-promotion document list after context compaction (checkpoint boundary)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/document-status-check.sh\"",
            "shell": "bash",
            "description": "Check document status consistency before session end"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/document-status-check.ps1\"",
            "shell": "powershell",
            "description": "Check document status consistency before session end"
          }
        ]
      }
    ]
  }
}
