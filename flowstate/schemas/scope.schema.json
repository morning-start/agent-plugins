{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/morning-start/agent-plugins/schemas/scope.schema.json",
  "title": "迭代范围说明书（5.2）",
  "description": "flowstate 产出物：迭代范围说明书，对应 PRD §5.2 / fst-init（N2 冻结）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["iteration", "in_scope", "out_scope", "frozen_core", "change_rule", "signed_by"],
  "properties": {
    "iteration": { "type": "string", "description": "迭代号" },
    "in_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本轮交付需求 id 列表"
    },
    "out_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "明确不做（含原因）"
    },
    "frozen_core": {
      "type": "array",
      "items": { "type": "string" },
      "description": "冻结的刚性核心需求 id"
    },
    "change_rule": { "type": "string", "description": "迭代内新增需求统一走变更流程" },
    "signed_by": { "type": "string", "description": "签署人 / 日期" }
  }
}
