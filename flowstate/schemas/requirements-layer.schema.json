{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/morning-start/agent-plugins/schemas/requirements-layer.schema.json",
  "title": "需求分层清单（5.1）",
  "description": "flowstate 产出物：需求分层清单（REQ-xxx），对应 PRD §5.1 / fst-init。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "source", "layer", "priority", "status"],
  "properties": {
    "id": { "type": "string", "description": "需求编号（REQ-001）" },
    "title": { "type": "string", "description": "需求标题" },
    "source": {
      "type": "string",
      "enum": ["业务方", "产品", "用户反馈", "技术自驱"],
      "description": "需求来源"
    },
    "layer": {
      "type": "string",
      "enum": ["刚性核心", "弹性细节", "临时新增", "待确认"],
      "description": "需求分层"
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "优先级"
    },
    "status": {
      "type": "string",
      "enum": ["待确认", "已冻结", "开发中", "已完成", "已排期", "已拒绝"],
      "description": "状态"
    },
    "known_gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "已知的模糊点、未知场景（显式记录）"
    },
    "iteration": { "type": "string", "description": "排入的迭代号（可为空）" }
  }
}
