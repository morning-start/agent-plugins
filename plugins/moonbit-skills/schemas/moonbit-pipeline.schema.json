{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/morning-start/moonbit-skills/schemas/moonbit-pipeline.schema.json",
  "title": "MoonBit Pipeline State (Checkpoint)",
  "description": "Persistent pipeline state and FST-compatible checkpoint for MoonBit development skills. Single source of truth for session recovery. Stored at .agent-workplace/state/checkpoint.json. Written by writing-plans, updated by implement/verify/evaluate/cd/learn.",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline",
    "phase",
    "status",
    "project_type",
    "targets",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for migration support"
    },
    "pipeline": {
      "type": "string",
      "enum": ["development", "bugfix", "spike", "release"],
      "description": "Pipeline mode"
    },
    "node": {
      "type": "string",
      "pattern": "^N[1-9]$",
      "description": "FST execution graph node (N1-N9). Maps pipeline phase to FST semantics."
    },
    "phase": {
      "type": "string",
      "enum": [
        "plan", "writing-plans", "scaffold", "testing",
        "implement", "review", "perform", "refactor",
        "verify", "evaluate", "cd", "learn", "incident"
      ],
      "description": "Current pipeline phase"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending", "in_progress", "blocked", "approved",
        "completed", "deployed", "rolled_back"
      ],
      "description": "Status of the current pipeline phase"
    },
    "batch": {
      "type": "integer",
      "minimum": 0,
      "description": "Current batch number (each batch max 5 tasks)"
    },
    "task_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Current task index within the batch"
    },
    "framework": {
      "type": "string",
      "enum": ["moonbit-skills-standalone", "flowstate"],
      "description": "Active workflow framework. 'flowstate' when FST drives the execution graph."
    },
    "project_type": {
      "type": "string",
      "enum": ["lib", "cli", "ffi", "wasm", "parser", "async"],
      "description": "MoonBit project type"
    },
    "primary_type": {
      "type": "string",
      "description": "Optional sub-type or capability focus"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Declared capabilities from plan phase"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["native", "wasm", "wasm-gc", "js"]
      },
      "minItems": 1,
      "description": "Declared build targets (drives verification matrix)"
    },
    "plan_file": {
      "type": "string",
      "description": "Path to the plan document"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 fingerprint of the plan file for consistency checks"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$",
      "description": "Git base commit when the plan was initialized"
    },
    "tasks": {
      "type": "object",
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "current": { "type": "integer", "minimum": 0 }
      },
      "required": ["total", "completed", "current"],
      "additionalProperties": false
    },
    "last_verification": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "UTC RFC 3339 timestamp of last verification"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "UTC RFC 3339 timestamp of last state update"
    },
    "next": {
      "type": "string",
      "description": "Next action hint for session recovery"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": 1,
      "pipeline": "development",
      "node": "N4",
      "phase": "implement",
      "status": "in_progress",
      "batch": 1,
      "task_index": 5,
      "framework": "moonbit-skills-standalone",
      "project_type": "cli",
      "primary_type": "parser",
      "capabilities": ["lexer", "tokenizer"],
      "targets": ["native"],
      "plan_file": ".agent-workplace/docs/plan/PLAN.md",
      "plan_sha256": "abc123def456abc123def456abc123def456abc123def456abc123def456abc1",
      "base_commit": "abc1234",
      "tasks": { "total": 13, "completed": 4, "current": 5 },
      "last_verification": "2026-07-29T10:30:00Z",
      "last_updated": "2026-07-29T10:30:00Z",
      "next": "implement:task-5"
    }
  ]
}
