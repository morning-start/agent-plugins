{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/session-start.sh",
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/session-start.ps1",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|create_file|str_replace_editor",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/post-tool-verify.sh",
            "shell": "bash",
            "description": "Post-edit structural gate (verify.mjs structure layer)"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|create_file|str_replace_editor",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/post-tool-verify.ps1",
            "shell": "powershell",
            "description": "Post-edit structural gate (verify.mjs structure layer)"
          }
        ]
      }
    ]
  }
}
