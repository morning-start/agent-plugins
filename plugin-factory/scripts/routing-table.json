{
  "version": 1,
  "comment": "Single source of truth for pf-* intent routing. scripts/route-intent.mjs reads the routes array (engine priority order, first match wins); scripts/render-routing.mjs renders the Skill Priority + Trigger Matrix tables in skills/using-pf/SKILL.md from this file; scripts/verify.mjs fails on drift. Edit here, then run: node scripts/render-routing.mjs",
  "routes": [
    {
      "scenario": "S9",
      "skill": "/pf-release",
      "path": "verify -> pf-version bump -> release",
      "keywords": ["release", "bump version", "bump", "tag it", "发布", "升版本", "打标签", "发版"],
      "priority": [{ "intent": "Release an existing plugin", "route": "S9 → `/pf-release` (verify → pf-version bump → release)" }],
      "trigger": { "en": "\"release\", \"bump version\", \"tag\"", "zh": "\"发布\", \"升版本\", \"打标签\"", "route": "`/pf-release` (S9)" }
    },
    {
      "scenario": "S1",
      "skill": "pf-intent (Full)",
      "path": "new plugin, no signed-off PRD",
      "keywords": ["create a plugin", "new plugin", "i have an idea", "make a plugin", "做一个插件", "创建一个插件", "创建插件", "插件想法", "新插件", "写一个插件"],
      "priority": [
        { "intent": "New plugin, no signed-off PRD", "route": "S1 → `pf-intent` (Full)" },
        { "intent": "Signed-off PRD, no design", "route": "S1 → `pf-design`" },
        { "intent": "Complexity verdict Light", "route": "S1 → `pf-build` directly (skip design)" },
        { "intent": "Component manifest signed off", "route": "S1 → `pf-build`" }
      ],
      "trigger": { "en": "\"create a plugin\", \"I have an idea\"", "zh": "\"创建插件\", \"做一个插件\", \"插件想法\"", "route": "`pf-intent` (S1 Full)" }
    },
    {
      "scenario": "S2",
      "skill": "pf-intent (Change)",
      "path": "add a skill -> design/build -> verify -> release",
      "keywords": ["add a skill", "add skill", "加个技能", "新增技能", "加技能"],
      "priority": [{ "intent": "Add a skill to an existing plugin", "route": "S2 → `pf-intent` (Change) → design/build → verify → release" }],
      "trigger": { "en": "\"change\", \"add a skill\", \"improve\"", "zh": "\"改一下\", \"加个技能\", \"优化技能\"", "route": "`pf-intent` (S2/S3 Change)" }
    },
    {
      "scenario": "S3",
      "skill": "pf-intent (Change, light)",
      "path": "improve -> build -> verify -> release",
      "keywords": ["improve", "improve a skill", "优化技能", "改进技能", "优化"],
      "priority": [{ "intent": "Improve a skill", "route": "S3 → `pf-intent` (Change, light) → build → verify → release" }],
      "trigger": { "en": "\"change\", \"add a skill\", \"improve\"", "zh": "\"改一下\", \"加个技能\", \"优化技能\"", "route": "`pf-intent` (S2/S3 Change)" }
    },
    {
      "scenario": "S4",
      "skill": "pf-lifecycle",
      "path": "split/merge/reorganize -> design -> build -> verify -> release",
      "keywords": ["split", "merge", "reorganize", "拆分", "合并", "重组"],
      "priority": [{ "intent": "Reorganize (split/merge) skills", "route": "S4 → `pf-analyze` → design → build → verify → release" }],
      "trigger": { "en": "\"split\", \"merge\", \"reorganize\"", "zh": "\"拆分\", \"合并\", \"重组\"", "route": "`pf-analyze` (S4)" }
    },
    {
      "scenario": "S5",
      "skill": "pf-lifecycle",
      "path": "confirm retire -> build (remove) -> verify -> release",
      "keywords": ["retire", "remove this skill", "remove skill", "退役", "删掉这个技能", "删除技能", "移除技能"],
      "priority": [{ "intent": "Retire one skill", "route": "S5 → `pf-analyze` (confirm) → build (remove) → verify → release" }],
      "trigger": { "en": "\"retire\", \"remove this skill\"", "zh": "\"退役\", \"删掉这个技能\"", "route": "`pf-analyze` → build (S5)" }
    },
    {
      "scenario": "S6",
      "skill": "pf-design (adapters)",
      "path": "port harness -> build -> verify -> release",
      "keywords": ["port", "add opencode", "add pi", "add a harness", "移植", "加个平台", "新平台", "支持 opencode", "支持 pi"],
      "priority": [{ "intent": "Add a harness (port)", "route": "S6 → `pf-design` (adapters) → build → verify → release" }],
      "trigger": { "en": "\"port\", \"add opencode/pi\"", "zh": "\"移植\", \"加个平台\"", "route": "`pf-design` (S6)" }
    },
    {
      "scenario": "S7",
      "skill": "pf-compose",
      "path": "orchestration tweak -> build -> verify -> release",
      "keywords": ["orchestration", "rework orchestration", "entry point", "改编排", "换入口", "编排"],
      "priority": [{ "intent": "Orchestration tweak", "route": "S7 → `pf-compose` → design → build → verify → release" }],
      "trigger": { "en": "\"rework orchestration\", \"entry\"", "zh": "\"改编排\", \"换入口\"", "route": "`pf-compose` (S7)" }
    },
    {
      "scenario": "S8",
      "skill": "pf-build (fix)",
      "path": "config/dependency fix -> verify -> release",
      "keywords": ["fix config", "fix hooks", "fix hook", "fix dependency", "修配置", "修 hook", "修复配置", "修 hook 配置"],
      "priority": [{ "intent": "Config / dependency fix", "route": "S8 → `pf-build` (fix) → verify → release" }],
      "trigger": { "en": "\"fix config\", \"fix hooks\"", "zh": "\"修配置\", \"修 hook\"", "route": "`pf-build` (S8)" }
    },
    {
      "scenario": "S10",
      "skill": "pf-lifecycle",
      "path": "lifecycle health -> recommendations -> route to S4/S5/S7",
      "keywords": ["analyze", "health", "what should evolve", "分析", "健康检查", "演进", "该演进了"],
      "priority": [{ "intent": "Analyze lifecycle health", "route": "S10 → `pf-analyze` → recommendations → route to S4/S5/S7" }],
      "trigger": { "en": "\"analyze\", \"health\", \"what should evolve\"", "zh": "\"分析\", \"健康检查\", \"该演进了\"", "route": "`pf-analyze` (S10)" }
    },
    {
      "scenario": null,
      "skill": null,
      "path": "answer directly; no scenario",
      "fallback": true,
      "keywords": ["how does", "how do i", "what is", "怎么用", "是什么", "一般提问"],
      "priority": [{ "intent": "Just a question", "route": "answer directly; no scenario" }],
      "trigger": { "en": "\"how does X work\", general question", "zh": "\"X 怎么用\", 一般提问", "route": "answer directly" }
    }
  ]
}
