# {{PLUGIN_NAME}} session-start bootstrap (PowerShell variant).
# Emits Claude-compatible hook JSON with the canonical using-<plugin> entry
# context. The renderer (scripts/render-bootstrap.mjs) owns marker/body
# generation; this hook only wires lifecycle and serializes the result.
$ErrorActionPreference = "SilentlyContinue"

$pluginRoot = Split-Path -Parent $PSScriptRoot

$nodeBin = $env:NODE
if (-not $nodeBin) {
    $nodeBin = (Get-Command node -ErrorAction SilentlyContinue).Source
}
if (-not $nodeBin) {
    Write-Output '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"[{{PLUGIN_NAME}}] node not found - entry skill not bootstrapped."}}'
    exit 0
}

Set-Location $pluginRoot
$json = & $nodeBin "$pluginRoot\scripts\render-bootstrap.mjs" --root $pluginRoot --plugin-name {{PLUGIN_NAME}} --harness claude 2>$null
if ($LASTEXITCODE -ne 0 -or -not $json) {
    Write-Output '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"[{{PLUGIN_NAME}}] entry skill not found - check skills/using-{{PLUGIN_NAME}}/SKILL.md."}}'
} else {
    Write-Output $json
}
exit 0
