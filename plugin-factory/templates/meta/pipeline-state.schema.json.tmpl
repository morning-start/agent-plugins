{
  "$id": "pipeline-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin Development Pipeline State",
  "description": "Tracks current phase and task progress across sessions. Auto-generated by plugin-factory scaffold.",
  "type": "object",
  "required": ["schema_version", "phase", "status", "tasks"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for migration tracking"
    },
    "pipeline": {
      "type": "string",
      "const": "development",
      "description": "Pipeline type identifier"
    },
    "phase": {
      "type": "string",
      "enum": ["design", "build", "verify", "release"],
      "description": "Current development phase"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "interrupted"],
      "description": "Current status"
    },
    "plan_file": {
      "type": "string",
      "description": "Path to the active plan file"
    },
    "tasks": {
      "type": "object",
      "required": ["total", "completed", "current"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "last_verification": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last verification"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last state update"
    },
    "next": {
      "type": "string",
      "description": "Next action identifier (e.g. 'build:task-3')"
    }
  },
  "additionalProperties": false
}
