{
  "name": "plugin-factory",
  "version": "0.2.0",
  "description": "A meta-plugin that guides agents through creating multi-agent plugins (Claude Code, pi, opencode) from intent, goals, and scenarios.",
  "keywords": [
    "agent",
    "plugin",
    "skill",
    "meta-plugin",
    "scaffolding",
    "claude-code",
    "pi",
    "opencode"
  ],
  "license": "MIT",
  "private": true,
  "pi": {
    "extensions": [
      ".pi/extensions/pf-bootstrap.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "omp": {
    "extensions": [
      ".pi/extensions/pf-bootstrap.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:harness": "node --test \"tests/harnesses/*.test.mjs\"",
    "test:harness:claude-code": "node --test tests/harnesses/claude-code.test.mjs",
    "test:harness:pi": "node --test tests/harnesses/pi.test.mjs",
    "test:harness:opencode": "node --test tests/harnesses/opencode.test.mjs",
    "test:harness:oh-my-pi": "node --test tests/harnesses/oh-my-pi.test.mjs",
    "test:harness:codex": "node --test tests/harnesses/codex.test.mjs",
    "validate": "bash tools/verify/validate-structure.sh",
    "validate:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify/validate-structure.ps1",
    "validate:node": "node tools/verify/verify.mjs structure --root .",
    "verify": "node tools/verify/verify.mjs --format table",
    "verify:json": "node tools/verify/verify.mjs --format json",
    "lifecycle": "node tools/verify/verify.mjs lifecycle --format table",
    "lifecycle:report": "node tools/verify/lifecycle-report.mjs",
    "version:check": "node tools/version/version.mjs check",
    "version:audit": "node tools/version/version.mjs audit",
    "release:check": "node tools/release/release-check.mjs",
    "smoke": "node --test tests/smoke/dogfood-smoke.test.mjs",
    "smoke:live": "node tests/smoke/run-live.mjs",
    "package": "node tools/release/package-plugin.mjs"
  }
}
