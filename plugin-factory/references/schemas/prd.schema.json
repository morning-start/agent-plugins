{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugin-factory.dev/schemas/prd.schema.json",
  "title": "One-Page PRD",
  "description": "Structured contract for the one-page PRD produced by pf-intent. The PRD is the single ticket into design and build (Iron Law 1); this schema validates its structural completeness before sign-off.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "version",
    "background",
    "goals",
    "features",
    "scenarios",
    "non_goals",
    "platforms",
    "language",
    "complexity"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Plugin name; lowercase letters, digits, and hyphens only."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "PRD version, e.g. 0.1.0."
    },
    "background": {
      "type": "string",
      "minLength": 10,
      "description": "Why now — one paragraph."
    },
    "goals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "2-3 measurable outcomes."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["verb", "object", "acceptance"],
        "properties": {
          "verb": { "type": "string", "description": "Action the plugin performs." },
          "object": { "type": "string", "description": "What the action applies to." },
          "acceptance": { "type": "string", "description": "One-line acceptance hint." }
        }
      },
      "description": "Numbered feature list: verb + object, one-line acceptance hint each."
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["context", "trigger", "behavior"],
        "properties": {
          "context": { "type": "string" },
          "trigger": { "type": "string" },
          "behavior": { "type": "string" }
        }
      },
      "description": "3-5 real situations: context -> trigger -> expected behavior."
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicitly out of scope — the scope-creep firewall."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["claude-code", "pi", "opencode", "oh-my-pi"]
      },
      "description": "Target harnesses."
    },
    "language": {
      "type": "object",
      "additionalProperties": true,
      "required": ["policy", "user_lang", "agent_lang"],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["tiered", "english", "native"],
          "description": "Default tiered; user may choose all-English or all-native."
        },
        "user_lang": { "type": "string", "description": "Maintenance/review layer language (e.g. zh-CN)." },
        "agent_lang": { "type": "string", "default": "en", "description": "Agent-executed layer language." }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skills", "hooks", "multi_harness", "rules"],
      "properties": {
        "skills": { "type": "integer", "minimum": 1, "description": "Estimated skill count." },
        "hooks": { "type": "boolean", "description": "Hooks required." },
        "multi_harness": { "type": "boolean", "description": "More than one harness." },
        "rules": { "type": "boolean", "description": "Rules/agents/subagents needed." }
      }
    },
    "sign_off": {
      "type": "object",
      "additionalProperties": true,
      "required": ["confirmed", "date"],
      "properties": {
        "confirmed": { "type": "boolean", "const": true },
        "date": { "type": "string", "format": "date" }
      },
      "description": "User confirmation + date — the mandatory gate."
    }
  }
}
