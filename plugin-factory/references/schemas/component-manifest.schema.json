{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugin-factory.dev/schemas/component-manifest.schema.json",
  "title": "Component Manifest",
  "description": "Structured contract for the component manifest produced by pf-design. No signed-off manifest -> no build (Iron Law 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "prefix",
    "version",
    "harnesses",
    "language",
    "components",
    "orchestration"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Plugin name; matches the PRD name."
    },
    "prefix": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Abbreviation prefix for skills/commands, e.g. pf."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["claude-code", "pi", "opencode", "oh-my-pi"]
      },
      "description": "Must be a subset of the PRD platforms."
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "user_lang", "agent_lang"],
      "properties": {
        "policy": { "type": "string", "enum": ["tiered", "english", "native"] },
        "user_lang": { "type": "string" },
        "agent_lang": { "type": "string", "default": "en" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "capability", "triggers", "consumes", "produces"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "Skill name; must equal its future directory name."
              },
              "capability": { "type": "string", "description": "Verb + object from a PRD feature." },
              "triggers": { "type": "string", "description": "CSO summary." },
              "consumes": { "type": "string", "description": "Artifact it reads." },
              "produces": { "type": "string", "description": "Artifact it writes." }
            }
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event", "action", "harnesses"],
            "properties": {
              "event": { "type": "string" },
              "action": { "type": "string" },
              "harnesses": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Harnesses that wire this hook."
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "purpose"],
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Rules only where the agent must not re-derive behavior."
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryPoints"],
      "properties": {
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^using-[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Methodology plugins need exactly one using-<plugin> bootstrap skill."
          }
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" },
            "description": "Ordered trigger chains; each link's artifact produced upstream."
          }
        },
        "handoffs": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "skill-a -> artifact.md."
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Declared trigger-domain exceptions; empty means mutually exclusive."
        }
      }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Shared docs multiple skills read."
    }
  }
}
