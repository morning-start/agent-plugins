{
  "name": "plugin-factory",
  "version": "0.1.0",
  "description": "A meta-plugin that guides agents through creating multi-agent plugins (Claude Code, pi, opencode) from intent, goals, and scenarios.",
  "keywords": [
    "agent",
    "plugin",
    "skill",
    "meta-plugin",
    "scaffolding",
    "claude-code",
    "pi",
    "opencode"
  ],
  "license": "MIT",
  "private": true,
  "pi": {
    "extensions": [
      ".pi/extensions/pf-bootstrap.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "omp": {
    "extensions": [
      ".pi/extensions/pf-bootstrap.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "validate": "bash scripts/validate-structure.sh",
    "validate:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-structure.ps1",
    "validate:node": "node scripts/verify.mjs structure --root .",
    "verify": "node scripts/verify.mjs --format table",
    "verify:json": "node scripts/verify.mjs --format json",
    "lifecycle": "node scripts/verify.mjs lifecycle --format table",
    "version:check": "node scripts/version.mjs check",
    "version:audit": "node scripts/version.mjs audit",
    "release:check": "node scripts/release-check.mjs",
    "smoke": "node --test tests/smoke/dogfood-smoke.test.mjs",
    "smoke:live": "node tests/smoke/run-live.mjs"
  }
}
